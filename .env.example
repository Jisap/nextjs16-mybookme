# NO commitear .env real. Copiar a .env
DATABASE_URL="postgresql://user:password@localhost:6543/mybookme?pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/mybookme"

# Supabase (nuevo formato API keys)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

AUTH_SECRET="cambiar-en-local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend). Sin RESEND_API_KEY → modo dev (log, no envía).
RESEND_API_KEY=""
EMAIL_FROM="MyBookMe <no-reply@mybookme.app>"

# Cron recordatorios (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="cambiar-en-local"
